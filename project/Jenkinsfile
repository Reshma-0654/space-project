pipeline {
    agent any

    tools {
        maven 'maven3'
    }

    environment {
        IMAGE_NAME = "reshma-nginx-app"
        CONTAINER_NAME = "reshma-nginx-container"
        PORT = "5000"
        CONTAINER_PORT = "80"
        DOCKER_REGISTRY = "docker.io"
        DOCKER_REPO = "reshma6540"
        IMAGE_TAG = "latest"
    }

    stages {

        stage('Debug Workspace') {
            steps {
                sh "pwd"
                sh "ls -l"
                sh "ls -l project || true"
            }
        }

        stage('Build with Maven') {
            steps {
                dir('project') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('project') {
                    withSonarQubeEnv('sq') {
                        withCredentials([string(credentialsId: 'SONAR_TOKEN', variable: 'SONAR_TOKEN')]) {
                            sh '''
                            mvn sonar:sonar \
                              -Dsonar.projectKey=reshma-app \
                              -Dsonar.host.url=http://16.176.21.182:9000 \
                              -Dsonar.login=$SONAR_TOKEN
                            '''
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                if [ ! -f project/Dockerfile ]; then
                    echo "Error: Dockerfile not found!"
                    exit 1
                fi
                '''
                sh "docker build -t $IMAGE_NAME:$IMAGE_TAG ./project"
                sh "docker tag $IMAGE_NAME:$IMAGE_TAG $DOCKER_REGISTRY/$DOCKER_REPO/$IMAGE_NAME:$IMAGE_TAG"
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'DOCKER_CREDS',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                    echo "$DOCKER_PASS" | docker login $DOCKER_REGISTRY -u "$DOCKER_USER" --password-stdin
                    docker push $DOCKER_REGISTRY/$DOCKER_REPO/$IMAGE_NAME:$IMAGE_TAG
                    docker logout $DOCKER_REGISTRY
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                export KUBECONFIG=/var/lib/jenkins/.kube/config

                if [ ! -f project/deployment.yml ]; then
                    echo "Error: deployment.yml not found!"
                    exit 1
                fi

                kubectl apply -f project/deployment.yml
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline executed successfully! 🚀"
        }
        failure {
            echo "Pipeline failed. Check logs."
        }
    }
}
